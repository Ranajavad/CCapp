{
  "expo": {
    "name": "Chapters & Chatters",
    "slug": "chapters-and-chatters",
    "scheme": "candc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#657159"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "no.chaptersandchatters.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "no.chaptersandchatters.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#657159"
      }
    },
    "locales": {
      "en": "./locales/en.json",
      "nb": "./locales/nb.json"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#657159"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {}
  }
}
