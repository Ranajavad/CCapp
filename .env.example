# Copy to .env and fill in. Values prefixed EXPO_PUBLIC_ are bundled into the app,
# so only ever put *public* keys here (the Supabase anon key is safe; the
# service-role key and the Anthropic key are NOT).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Optional: Google Books API key (works without one, but with lower quota)
EXPO_PUBLIC_GOOGLE_BOOKS_KEY=

# Optional: Google Maps Platform key with "Places API (New)" enabled.
# Without it, meeting locations are typed in by hand.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=
